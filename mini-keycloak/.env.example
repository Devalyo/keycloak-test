# Copy this file to .env and restrict it to your account (chmod 600 .env).
# Generate three INDEPENDENT values with Python secrets.token_hex(32) or a password
# manager. Keep them stable across restarts and backups; do not commit the values.
# The database password must be hexadecimal because it is interpolated into a URI.
# Empty values below intentionally prevent Compose startup.
POSTGRES_PASSWORD=
MINI_KEYCLOAK_SECRET_KEY=
MINI_KEYCLOAK_OIDC_KEY_ENCRYPTION_SECRET=

# Only 127.0.0.1 is published; the public issuer is https://localhost:<port>.
MINI_KEYCLOAK_HTTPS_PORT=8443
# Caddy has this fixed private address, and only this exact /32 is trusted.
# If another local project overlaps, change BOTH settings consistently.
MINI_KEYCLOAK_PROXY_SUBNET=172.30.83.0/24
MINI_KEYCLOAK_PROXY_ADDRESS=172.30.83.254
# Export only /data/caddy/pki/authorities/local/root.crt from Caddy to trust TLS.
# The private CA keys stay in caddy_data; never copy that volume into the repo.
