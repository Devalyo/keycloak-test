{
	admin off
	auto_https disable_redirects
	# Do not install the local CA into the container's trust store.
	skip_install_trust
	log {
		# Proxy errors can otherwise contain complete request headers and URIs.
		exclude http.log.access http.log.error
	}
}

https://localhost {
	tls internal
	@health path /health /health/*
	respond @health "Not found" 404
	reverse_proxy web:8000 {
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto https
	}
}
